rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Removed the exists() preflight — if the user doc is missing, getUserData()
    // returns null and the role comparison is false, which is the same outcome.
    // The exists() calls inside function bodies caused the CLI "Invalid variable
    // name: request" warnings on the path interpolation $(request.auth.uid).

    // isSuperAdmin: only the super-admin account passes this check.
    function isSuperAdmin() {
      return isSignedIn() && getUserData(request.auth.uid).role == "super-admin";
    }

    // isAdmin: true for both "admin" and "super-admin" — used for general
    // content management (events, library, forms, etc.).
    function isAdmin() {
      return isSignedIn() && (
        getUserData(request.auth.uid).role == "admin" ||
        getUserData(request.auth.uid).role == "super-admin"
      );
    }

    function isSinger() {
      return isSignedIn() && getUserData(request.auth.uid).role == "singer";
    }

    // ── Collections ────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if true;

      // Self-create (signup flow), super-admin creates any user,
      // or regular admin creates non-admin/non-super-admin users only.
      allow create: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isAdmin() &&
          request.resource.data.role != "admin" &&
          request.resource.data.role != "super-admin")
      );

      // Self-update, super-admin updates any user,
      // or regular admin updates non-admin users without role escalation.
      allow update: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isAdmin() &&
          resource.data.role != "admin" &&
          resource.data.role != "super-admin" &&
          request.resource.data.role != "admin" &&
          request.resource.data.role != "super-admin")
      );

      // Only super-admin can delete user documents.
      allow delete: if isSuperAdmin();
    }

    match /join_requests/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /messages/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.sender_id ||
                        request.auth.uid == resource.data.receiver_id ||
                        isAdmin());
    }

    match /notifications/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       (request.auth.uid == resource.data.target_uid || isAdmin());
    }

    match /message_students/{docId} { allow read, write: if isSignedIn(); }
    match /message_groups/{docId}   { allow read, write: if isSignedIn(); }

    match /statistics_reports/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /rejection/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{docId} {
      allow read:           if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete:         if isAdmin();
    }

    match /rsvps/{docId} {
      allow read:           if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete:         if isAdmin();
    }

    match /library/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /forms/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /chat_groups/{groupId} {
      allow read, write: if isSignedIn();
    }

    // Students can create and read only their own submissions; admins have full access.
    match /form_submissions/{docId} {
      allow create: if isSignedIn();
      allow read:   if isSignedIn() &&
                       (resource.data.student_id == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /groups/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /voice_types/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /achievements/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read, write: if isSignedIn();
    }

    match /leaderboard_config/{docId} {
      allow read, write: if isSignedIn();
    }

    match /event_students/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
